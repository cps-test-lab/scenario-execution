import osc.helpers

# Succeeds once `close == 1` has held for 2 s without a break. The first branch plays the part of a
# sensor: close from 1 s, broken at 2 s, close again from 2.5 s. The first second of holding does
# not count, so the scenario ends at 4.5 s.
scenario held_for_duration:
    var close: int = 0
    do one_of:
        serial:
            wait elapsed(1s)
            increment(close)
            log('close')
            wait elapsed(1s)
            decrement(close)
            log('broken')
            wait elapsed(0.5s)
            increment(close)
            log('close again')
            wait elapsed(60s)
        serial:
            serial:
                wait close == 1
                one_of:
                    wait elapsed(2s)
                    serial:
                        wait close == 0
                    with:
                        success_is_failure()
            with:
                retry()
            log('held for 2 s')
        with:
            timeout(10s)
